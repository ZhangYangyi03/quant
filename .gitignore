# 数据矩阵：约 1.9GB，用 build_*.py 从 stockdata/ 重建
*.bin
*.pkl
*.db

# 原始与中间数据
stockdata/
store/
shards/
live/
data/
__pycache__/

# 日志与诊断
*.log
*.txt
*.stdout
*.csv
!data/*.csv
!data_extra/*.csv
dbg_*
diag_*
memscan*

# 临时与中间产物
_*.py
_*.json
r1_*.json
r2_*.json
r3_*.json
r4_*.json
r5_*.json
r6_*.json
flat_*.json
factor_papers.json
bench_curve_cache.json
idxcache.json
sweep.json
strategy_compare.json
universe*.json
universe_all_results.json
etf_rotate.json
results_etf.json
eg_shocks.csv

# 因子分片缓存（由 factor_lab.py 重建，单机可达 30MB+）
fl_cache/
fl_cache_old/

# 面板与分段中间产物（可由 m_*.bin 重建，不进仓库）
m_compact.bin
fscan_parts/
ic_fast.npz
_sr_ret.npy
_run_ic.cmd
_sr_panel*.pkl
_sr_rets.npy
_sr_rb.npy
fpanel*.npz
fpanel_g.npz.tmp
AL_bool.npy

# 因子分片与财报分页：可由 fcalc.py / fundpull.py 重建，不进仓库
alpha_parts/
fund_parts/

*.out

# 2026-11-05 机构级改造：上面的通用规则会误伤新增的 quantlab 包。
# 「data/」本意只排除仓库根目录的原始 CSV 数据，不应吃掉 quantlab/data/ 源码；
# 「_*.py」本意排除临时脚本，不应吃掉各包的 __init__.py（否则包无法导入）。
!quantlab/data/
!quantlab/data/**
quantlab/data/__pycache__/
*.pyc
!__init__.py

# qlib 桥接层
.qlibenv/
qlib_bridge/qlib_data/

# 非价量原始数据（可重跑生成，不入库）
alt_data/
